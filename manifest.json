{
  "manifest_version": 3,
  "name": "Monsnode Multi Player",
  "version": "1.5.8",
  "description": "Select Monsnode search results and play them in a multi-panel view.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Monsnode Multi Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://monsnode.com/*",
    "https://*.monsnode.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://monsnode.com/*", "https://*.monsnode.com/*"],
      "js": ["search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://monsnode.com/*",
        "https://*.monsnode.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://monsnode.com/*",
        "https://*.monsnode.com/*"
      ],
      "js": ["visibility.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_page": "options.html"
}
